from typing import List

class Solution:
    def minRemoval(self, nums: List[int], k: int) -> int:
        nums.sort()
        left = 0
        max_kept = 0

        for right in range(len(nums)):
            while nums[right] > nums[left] * k:
                left += 1
            max_kept = max(max_kept, right - left + 1)

        return len(nums) - max_kept

