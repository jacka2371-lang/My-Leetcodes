from typing import List

class Solution:
    def numSimilarGroups(self, strs: List[str]) -> int:
        n = len(strs)
        parent = list(range(n))

        def find(x):
            if parent[x] != x:
                parent[x] = find(parent[x])
            return parent[x]

        def union(x, y):
            px, py = find(x), find(y)
            if px != py:
                parent[py] = px

        def is_similar(a, b):
            diff = []
            for i in range(len(a)):
                if a[i] != b[i]:
                    diff.append(i)
                    if len(diff) > 2:
                        return False
            return len(diff) == 0 or len(diff) == 2

        for i in range(n):
            for j in range(i + 1, n):
                if is_similar(strs[i], strs[j]):
                    union(i, j)

        return len({find(i) for i in range(n)})
